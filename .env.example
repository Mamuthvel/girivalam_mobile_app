# Supabase configuration
# Copy this file to `.env` and fill in your project's values.
# These are exposed to the client (Vite `VITE_` prefix), so only use the
# public anon/publishable key here — never the service_role key.
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# ─── Map basemap tiles (optional) ────────────────────────────────────────────
# No key needed: the app defaults to Esri's key-free ArcGIS tiles. Those work,
# but street detail stops at zoom 17 and is upscaled (blurry) beyond that.
#
# Set ONE of these for sharper tiles:
#   VITE_CARTO_API_KEY  - free, no account needed: https://carto.com/basemaps/apikey
#                         5M tiles/month non-commercial, 1M/month commercial.
#                         Free key serves to zoom 18; z19+ returns HTTP 403.
#   VITE_MAPTILER_KEY   - requires a MapTiler account: https://www.maptiler.com/
# If both are set, MapTiler wins. Run `npm run verify:tiles` after changing one.
#
# NOTE for the packaged app: the Android WebView loads from https://localhost
# (capacitor.config.ts androidScheme), so a CARTO key restricted by website
# must allow `localhost` or tiles will 403 inside the app.
#
# Never point the app at OpenStreetMap's volunteer tile servers
# (tile.openstreetmap.org) — their tile usage policy forbids app basemaps and
# they block clients that do: https://operations.osmfoundation.org/policies/tiles/
VITE_CARTO_API_KEY=""
VITE_MAPTILER_KEY=""
