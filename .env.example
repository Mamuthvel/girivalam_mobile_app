# Supabase configuration
# Copy this file to `.env` and fill in your project's values.
# These are exposed to the client (Vite `VITE_` prefix), so only use the
# public anon/publishable key here — never the service_role key.
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
